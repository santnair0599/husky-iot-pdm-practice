# Copy to terraform.tfvars (git-ignored) for local plans. CI reads the same
# values from the GitHub "prod" environment variables (TF_VAR_*).
resource_group_name    = "rg-husky-pdm-prod"
location               = "eastus2"
storage_account_name   = "sthuskypdmprod0599"
iot_hub_name           = "iot-husky-pdm-prod-0599"
iot_hub_sku            = "B1"
adx_cluster_name       = "adxhuskypdmprod0599"
adx_database_name      = "pdm_prod"
create_data_connection = false # true after the first KQL release
synapse_mode           = "none" # "existing" after the admin creates the workspace
synapse_workspace_name = "syn-husky-pdm-prod-0599"
synapse_location       = "centralus"
# alert_email: set $env:TF_VAR_alert_email in your session, never here
